<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp"
        android:paddingVertical="4dp">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_title"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <!-- 历史与当前句分别排版；当前句定稿不改变历史区的尺寸或滚动位置。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <ScrollView
            android:id="@+id/scrollSubtitles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:fillViewport="true">
            <TextView
                android:id="@+id/tvSubtitles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:lineSpacingMultiplier="1.4"
                android:paddingHorizontal="24dp"
                android:paddingVertical="12dp"
                android:textColor="@color/text_primary"
                android:textSize="30sp" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@color/surface"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvLatestSpeaker"
                android:layout_width="match_parent"
                android:layout_height="28dp"
                android:paddingHorizontal="24dp"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/latest_caption_title"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
            <ScrollView
                android:id="@+id/scrollCurrentCaption"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">
                <TextView
                    android:id="@+id/tvCurrentCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="top"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="12dp"
                    android:lineSpacingMultiplier="1.4"
                    android:text="@string/initial_hint"
                    android:textColor="@color/caption_latest"
                    android:textSize="30sp" />
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/btnLatest"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="end"
        android:layout_marginEnd="20dp"
        android:text="@string/caption_jump_latest"
        android:textColor="@color/text_primary"
        android:backgroundTint="@color/surface"
        android:visibility="gone" />
    <TextView
        android:id="@+id/tvEnvAlert"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/env_alert"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:textColor="@color/env_alert_text"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone" />
    <Button
        android:id="@+id/btnMain"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="24dp"
        android:backgroundTint="@color/accent"
        android:text="@string/btn_start"
        android:textColor="#062733"
        android:textSize="19sp"
        android:textStyle="bold" />
</LinearLayout>
